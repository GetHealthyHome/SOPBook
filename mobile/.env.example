# Copy to mobile/.env.local and fill in. Never commit real values.
#
# NOTE ON SECRETS: anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle
# and is readable by anyone with the app binary. The Housecall Pro API key is
# therefore NOT read from here at runtime — it is entered once by the tech and
# stored in the device Keychain/Keystore via expo-secure-store. These values are
# for pointing the app at an environment only.

# Housecall Pro API base. Override to hit a proxy/staging gateway.
EXPO_PUBLIC_HCP_API_BASE=https://api.housecallpro.com

# Optional: a backend of yours that brokers the Housecall Pro token so the
# device never holds a company-wide key. Leave blank to use direct API keys.
EXPO_PUBLIC_TOKEN_BROKER_URL=

# Set to 1 only in a dev build whose SQLite is compiled with SQLCipher.
# See src/db/encryption.ts for what this switches on.
EXPO_PUBLIC_SQLCIPHER=0
