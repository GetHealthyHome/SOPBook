# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and NEVER committed.

# Supabase project credentials (Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key (not the anon key) — required for server-side writes
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Session signing secret — generate with: openssl rand -hex 64
SESSION_SECRET=replace_with_64_byte_hex_secret

# Fallback account passwords — set strong unique passwords, never commit
# real values. Accounts whose variable is unset or empty are disabled
# (they can never log in via the env fallback).
PW_MARCUS=change_me
PW_SARAH=change_me
PW_ALEX=change_me
PW_DERRICK=change_me

# ---------------------------------------------------------------------------
# Outbound email — invitations and acknowledgement reminders.
#
# Sends through the company's own Microsoft 365 or Google Workspace mailbox,
# so mail arrives from an address the crew already recognises. All of this is
# optional: with it unset the app still works, invitations just have to be
# copied and passed on by hand from the admin console.
#
# Microsoft 365:    SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Google Workspace: SMTP_HOST=smtp.gmail.com      SMTP_PORT=587
#
# Both providers refuse a normal account password here. Create an app password
# instead (Google: Account → Security → App passwords; Microsoft: requires an
# account with SMTP AUTH enabled and MFA app password support).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=fieldguide@yourcompany.com
SMTP_PASS=your_app_password
# The From address. Usually the same as SMTP_USER — most providers reject a
# From that the authenticated mailbox is not allowed to send as.
SMTP_FROM=Healthy Home Field Guide <fieldguide@yourcompany.com>

# Where invitation links point. Must be the real public URL, or new members
# get a link to a site they cannot reach.
APP_URL=https://your-field-guide-domain.com
