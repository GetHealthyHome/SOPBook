# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and NEVER committed.

# Supabase project credentials (Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key (not the anon key) — required for server-side writes
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Session signing secret — generate with: openssl rand -hex 64
SESSION_SECRET=replace_with_64_byte_hex_secret

# Fallback account passwords — set strong unique passwords, never commit
# real values. Accounts whose variable is unset or empty are disabled
# (they can never log in via the env fallback).
PW_MARCUS=change_me
PW_SARAH=change_me
PW_ALEX=change_me
PW_DERRICK=change_me

# ---------------------------------------------------------------------------
# Outbound email — invitations and acknowledgement reminders.
#
# Sends through Resend (https://resend.com). The free tier covers 3,000
# messages a month and 100 a day, which is far more than a crew this size
# will use. All of this is optional: with it unset the app still works,
# invitations just have to be copied and passed on by hand from the admin
# console.
#
# Setup:
#   1. Create a Resend account and an API key (starts with "re_").
#   2. Add your domain under Domains and publish the DNS records it gives
#      you. This step is not optional — see the warning below.
#   3. Set EMAIL_FROM to an address at that verified domain.
#
# WARNING: until a domain is verified, Resend only lets you send to the
# account owner's own email address. Everything will look configured and
# invitations to anyone else will fail with a 403. The admin console shows
# that error verbatim, so it is recoverable, but verify the domain first.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
# Must be at a domain verified in Resend. A display name is optional.
EMAIL_FROM=Healthy Home Field Guide <fieldguide@yourcompany.com>

# Where invitation links point. Must be the real public URL, or new members
# get a link to a site they cannot reach.
APP_URL=https://your-field-guide-domain.com
